{{#if plans}}
<h1>My Plans</h1>
{{#each plans}}
<p>{{this.title}} - {{this.date}}</p>
<a href="/plans/{{this._id}}">View Plan</a>
{{/each}}
{{/if}}

{{#if attending.length}}
<section class="attending">
  <h2>Plans you're attending</h2>
  {{#each attending}}
  <div class="attending-plan">
    <a href="/plans/{{this._id}}">{{this.title}}</a>
    <span class="muted">by {{this.ownerName}}{{#if this.date}} &middot; {{this.date}}{{/if}} &middot; you're {{this.myStatus}}</span>
  </div>
  {{/each}}
</section>
{{/if}}

{{#if plan}}
<p>{{plan.title}} - {{plan.date}}</p>

{{#if isOwner}}
<form method="POST" action="/plans/{{plan._id}}?_method=PUT">
  <label>Title</label>
  <input type="text" name="title" value="{{plan.title}}" />

  <label>Date</label>
  <input type="date" name="date" value="{{plan.date}}" />

  <label>Status</label>
  <select name="status">
    <option value="active" {{#if (eq plan.status 'active' )}}selected{{/if}}>Active</option>
    <option value="saved" {{#if (eq plan.status 'saved' )}}selected{{/if}}>Saved</option>
    <option value="completed" {{#if (eq plan.status 'completed' )}}selected{{/if}}>Completed</option>
  </select>

  <div>
    <label>Public</label>
    <input type="checkbox" name="isPublic" value="true" {{#if plan.isPublic}}checked{{/if}} />
  </div>

  <button type="submit">Update</button>
</form>

<form method="POST" action="/plans/{{plan._id}}?_method=DELETE">
  <button type="submit">Delete</button>
</form>
{{/if}}

{{#unless isOwner}}
<form method="POST" action="/plans/{{plan._id}}/clone">
  <button type="submit">Copy this plan to my plans</button>
</form>
{{/unless}}

<h2>Activities</h2>
{{#if isOwner}}
<a href="/explore">+ Add Activity from Explore</a>
{{/if}}

{{#if travelLegs.length}}
<section class="plan-travel-estimates">
  <h3>Estimated Travel Time</h3>
  <p>Total estimated travel time: ~{{totalTravelMinutes}} minutes</p>
  {{#if unknownLegCount}}
  <p class="muted">Some travel legs could not be estimated due to missing location coordinates.</p>
  {{/if}}
  <ul>
    {{#each travelLegs}}
      <li>
        {{this.fromName}} -> {{this.toName}}:
        {{#if this.minutes}}~{{this.minutes}} min{{else}}N/A{{/if}}
      </li>
    {{/each}}
  </ul>
</section>
{{/if}}

{{#if plan.activities}}
{{#each plan.activities}}
<div>
  <a href="/explore/{{this.locationId}}">
    <strong>{{this.locationName}}</strong>
    <p>{{this.startTime}} - {{this.endTime}}: {{this.notes}}</p>
  </a>
  {{#if isOwner}}
  <form method="POST" action="/plans/{{../plan._id}}/activities/{{this._id}}?_method=DELETE">
    <button type="submit">Delete Activity</button>
  </form>
  {{/if}}
</div>
{{/each}}
{{else}}
<p>No activities yet</p>
{{/if}}

<section class="plan-attendees">
  <h2>Who's in?</h2>

  {{#if going.length}}
  <p><strong>Going:</strong>
    {{#each going}}<a href="/profile/{{this.userId}}">{{this.name}}</a>{{#unless @last}}, {{/unless}}{{/each}}
  </p>
  {{/if}}
  {{#if interested.length}}
  <p><strong>Interested:</strong>
    {{#each interested}}<a href="/profile/{{this.userId}}">{{this.name}}</a>{{#unless @last}}, {{/unless}}{{/each}}
  </p>
  {{/if}}
  {{#if invitedPending.length}}
  <p><strong>Invited (no reply yet):</strong>
    {{#each invitedPending}}{{this.name}}{{#unless @last}}, {{/unless}}{{/each}}
  </p>
  {{/if}}
  {{#unless going.length}}{{#unless interested.length}}{{#unless invitedPending.length}}
  <p>No one invited yet.</p>
  {{/unless}}{{/unless}}{{/unless}}

  {{#if isInvited}}
  <div class="rsvp-controls">
    <p>Your RSVP: {{#if myRsvp}}{{myRsvp}}{{else}}no reply{{/if}}</p>
    <form method="POST" action="/plans/{{plan._id}}/rsvp">
      <button type="submit" name="status" value="going">I'm going</button>
      <button type="submit" name="status" value="interested">Interested</button>
      <button type="submit" name="status" value="not_going">Can't go</button>
    </form>
  </div>
  {{/if}}

  {{#if isOwner}}
  <div class="invite-controls">
    <h3>Invite a friend</h3>
    {{#if invitableFriends.length}}
    <form method="POST" action="/plans/{{plan._id}}/invite">
      <select name="friendId" required>
        {{#each invitableFriends}}
        <option value="{{this._id}}">{{this.name}}</option>
        {{/each}}
      </select>
      <button type="submit">Invite</button>
    </form>
    {{else}}
    <p class="muted">No more friends to invite.</p>
    {{/if}}

    {{#if invitedPending.length}}
    <h4>Uninvite</h4>
    {{#each invitedPending}}
    <form method="POST" action="/plans/{{../plan._id}}/attendees/{{this.userId}}">
      <button type="submit">Remove {{this.name}}</button>
    </form>
    {{/each}}
    {{/if}}
  </div>
  {{/if}}
</section>

<section class="plan-social">
  <form method="POST" action="/plans/{{plan._id}}/react">
    <button type="submit">{{#if hasReacted}}&#128077; Liked{{else}}&#128077; Like{{/if}}</button>
  </form>
  <p class="muted">{{reactionCount}} like{{#unless (eq reactionCount 1)}}s{{/unless}}</p>

  <h2>Comments</h2>
  <form method="POST" action="/plans/{{plan._id}}/comments">
    <input type="text" name="text" placeholder="Add a comment" maxlength="1000" required />
    <button type="submit">Post</button>
  </form>

  {{#if comments.length}}
  {{#each comments}}
  <div class="plan-comment">
    <p><strong>{{this.authorName}}</strong>: {{this.text}}</p>
    {{#if this.canDelete}}
    <form method="POST" action="/plans/{{../plan._id}}/comments/{{this._id}}">
      <button type="submit">Delete</button>
    </form>
    {{/if}}
  </div>
  {{/each}}
  {{else}}
  <p>No comments yet.</p>
  {{/if}}
</section>
{{/if}}
