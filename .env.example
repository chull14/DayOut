# Copy this file to .env and fill in real values. .env is gitignored.
# The app loads .env automatically on `npm start` (via --env-file-if-exists).

# ---- AI recommendation reasons (optional) ----
# With no key, recommendation cards still show a plain heuristic "why" line.
# Add a key to have Claude write the sentences instead. Nothing else changes.
AI_API_KEY=
# Optional override; defaults to a fast, cheap model.
# AI_MODEL=claude-3-5-haiku-latest

# ---- Session ----
# Overrides the session signing secret (see app.js).
# SESSION_SECRET=
